{
  "info": {
    "name": "EnglishYaari Booking API",
    "description": "Run the requests in order against a running API. Set teacherId to the ID printed by npm run seed:teacher.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "teacherId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "dateTimestamp",
      "value": ""
    },
    {
      "key": "startTime",
      "value": ""
    },
    {
      "key": "endTime",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Demo Learner\",\n  \"email\": \"{{userEmail}}\",\n  \"phone\": \"+919876543210\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"userEmail\", \"learner-\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"userId\", pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create available session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/sessions"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const start = new Date(Date.now() + 86400000);",
              "pm.collectionVariables.set(\"startTime\", start.toISOString());",
              "pm.collectionVariables.set(\"endTime\", new Date(start.getTime() + 1800000).toISOString());",
              "pm.collectionVariables.set(\"dateTimestamp\", String(start.getTime()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const session = pm.response.json();",
              "pm.collectionVariables.set(\"sessionId\", session._id);",
              "pm.test(\"Session is available\", () => pm.expect(session.status).to.eql(\"AVAILABLE\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "List available sessions",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"New session is listed\", () => {",
              "  pm.expect(pm.response.json().some(session => session._id === pm.collectionVariables.get(\"sessionId\"))).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Book session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/sessions/{{sessionId}}/book"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Session is booked\", () => pm.expect(pm.response.json().status).to.eql(\"BOOKED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject repeat booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/sessions/{{sessionId}}/book"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "List upcoming sessions",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/{{userId}}/sessions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Booked session is upcoming\", () => {",
              "  pm.expect(pm.response.json().upcomingSessions.map(session => session._id)).to.include(pm.collectionVariables.get(\"sessionId\"));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Complete session",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/sessions/{{sessionId}}/complete"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const session = pm.response.json();",
              "pm.test(\"Session is completed and timestamped\", () => {",
              "  pm.expect(session.status).to.eql(\"COMPLETED\");",
              "  pm.expect(Number.isFinite(Date.parse(session.completedAt))).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List completed sessions",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/{{userId}}/sessions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const history = pm.response.json();",
              "pm.test(\"Session moved to completed history\", () => {",
              "  const sessionId = pm.collectionVariables.get(\"sessionId\");",
              "  pm.expect(history.upcomingSessions.map(session => session._id)).not.to.include(sessionId);",
              "  pm.expect(history.completedSessions.map(session => session._id)).to.include(sessionId);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
